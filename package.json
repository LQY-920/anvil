{
  "name": "anvil",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "scripts": {
    "dev": "concurrently -n server,web,runner -c blue,green,yellow \"pnpm dev:server\" \"pnpm dev:web\" \"pnpm dev:runner\"",
    "dev:server": "pnpm --filter @anvil/server dev",
    "dev:runner": "pnpm --filter @anvil/runner dev",
    "dev:web": "pnpm --filter @anvil/web dev",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "concurrently": "^9"
  }
}
